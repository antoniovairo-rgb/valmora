{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missione.schema.json",
  "title": "data/missioni/<id>.json: una missione per episodio",
  "type": "object",
  "required": [
    "id",
    "stagione",
    "episodio",
    "titolo",
    "disponibile_se",
    "briefing",
    "mappa",
    "ondate",
    "esiti",
    "fili",
    "stelle"
  ],
  "additionalProperties": false,
  "properties": {
    "partita": {
      "type": "object",
      "description": "D-130 (C26-06): la sfida della serata quando le curve dei dati non la dicono (casa senza curva, ospiti chiusi fuori)",
      "required": ["casa", "ospiti"],
      "additionalProperties": false,
      "properties": {
        "casa": { "$ref": "comune.schema.json#/$defs/id" },
        "ospiti": { "$ref": "comune.schema.json#/$defs/id" }
      }
    },
    "id": {
      "$ref": "comune.schema.json#/$defs/id"
    },
    "stagione": {
      "type": "integer",
      "minimum": 1
    },
    "episodio": {
      "type": "integer",
      "minimum": 1
    },
    "titolo": {
      "$ref": "comune.schema.json#/$defs/testo"
    },
    "disponibile_se": {
      "$ref": "comune.schema.json#/$defs/condizione"
    },
    "briefing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "testo",
          "fonte",
          "affidabilita",
          "vera"
        ],
        "additionalProperties": false,
        "properties": {
          "testo": {
            "$ref": "comune.schema.json#/$defs/testo"
          },
          "fonte": {
            "$ref": "comune.schema.json#/$defs/id"
          },
          "affidabilita": {
            "enum": [
              "bassa",
              "media",
              "alta"
            ]
          },
          "vera": {
            "type": "boolean",
            "description": "il verbale rivela sempre se l'informazione era vera (D-024)"
          },
          "settore": {
            "$ref": "comune.schema.json#/$defs/id",
            "description": "settore che la fonte accende sulla mappa"
          }
        }
      }
    },
    "mappa": {
      "type": "object",
      "required": [
        "settori",
        "risorse"
      ],
      "additionalProperties": false,
      "properties": {
        "settori": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "tipo"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "comune.schema.json#/$defs/id"
              },
              "tipo": {
                "$ref": "comune.schema.json#/$defs/id"
              },
              "club": {
                "$ref": "comune.schema.json#/$defs/id",
                "description": "club della curva (D-086): ne prende i colori sulla mappa"
              },
              "meta": {
                "$ref": "comune.schema.json#/$defs/id",
                "description": "C27-02: settore dove finisce il viale di questa strada (municipio, stazione); se manca, lo stadio o il centro"
              },
              "pos": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "description": "posizione del settore sulla mappa tattica, 0-100 (x da sinistra, y dall'alto)",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "risorse": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "quantita",
              "efficacia"
            ],
            "additionalProperties": false,
            "properties": {
              "quantita": {
                "type": "integer",
                "minimum": 1
              },
              "massimo": {
                "type": "integer",
                "minimum": 1,
                "description": "C17-14: tetto delle unità di questa risorsa anche dopo i rientri (riserva positiva)"
              },
              "efficacia": {
                "type": "object",
                "description": "pressione assorbita da un'unità, per tipo di settore (assente = 0)",
                "propertyNames": {
                  "pattern": "^[a-z0-9_]+$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "dimezza": {
                "type": "array",
                "uniqueItems": true,
                "description": "tipi di evento che un'unità dimezza nel suo settore (D-037)",
                "items": {
                  "$ref": "comune.schema.json#/$defs/id"
                }
              },
              "fissa": {
                "type": "boolean",
                "description": "unità fisse (D-082): una volta piazzate restano nel settore per tutte le ondate dopo, non tornano disponibili e non vanno a riposo"
              }
            }
          }
        },
        "ora": {
          "enum": [
            "giorno",
            "notte"
          ],
          "description": "ora della partita sulla mappa (S-07, e03): senza, giorno"
        },
        "dettagli": {
          "type": "array",
          "uniqueItems": true,
          "description": "dettagli grafici della mappa disegnati dal codice (D-084, D-095): «id» al centro oppure «id@settore» vicino al settore",
          "items": {
            "type": "string",
            "pattern": "^(cartelloni_stadio_nuovo|banca|zona_rossa|palco_concerto|piazza_storica|fabbrica|stabile_occupato|incidente|cantiere_stadio|porto|mercato)(@[a-z0-9_]+)?$"
          }
        }
      }
    },
    "ondate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "eventi"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "titolo": {
            "$ref": "comune.schema.json#/$defs/testo"
          },
          "fase": {
            "enum": ["prima", "partita", "dopo"],
            "description": "C27-04: fase della partita detta dai testi dell'ondata; se manca, la decidono gli eventi «curva»"
          },
          "eventi": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "tipo",
                "settore",
                "pressione"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "tipo": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "settore": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "se": {
                  "$ref": "comune.schema.json#/$defs/condizione"
                },
                "pressione": {
                  "type": "integer",
                  "minimum": 0
                },
                "club": {
                  "$ref": "comune.schema.json#/$defs/id",
                  "description": "C-021: club dei tifosi dell'evento in strada (colori del corteo); se manca, quello della strada"
                },
                "verso": {
                  "enum": ["verso_lo_stadio", "dallo_stadio"],
                  "description": "D-127 (C24-07): verso del corteo in strada; se manca, lo decide la partita (prima: verso lo stadio, dopo: via)"
                }
              }
            }
          },
          "chiamate": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "fonte",
                "testo",
                "opzioni"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "fonte": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "testo": {
                  "$ref": "comune.schema.json#/$defs/testo"
                },
                "settore": {
                  "$ref": "comune.schema.json#/$defs/id"
                },
                "se": {
                  "$ref": "comune.schema.json#/$defs/condizione"
                },
                "opzioni": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "testo",
                      "effetti"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "comune.schema.json#/$defs/id"
                      },
                      "testo": {
                        "$ref": "comune.schema.json#/$defs/testo"
                      },
                      "costo": {
                        "$ref": "comune.schema.json#/$defs/testo"
                      },
                      "se": {
                        "$ref": "comune.schema.json#/$defs/condizione"
                      },
                      "effetti": {
                        "type": "array",
                        "items": {
                          "$ref": "comune.schema.json#/$defs/effetto_missione"
                        }
                      },
                      "risposta": {
                        "$ref": "comune.schema.json#/$defs/testo",
                        "description": "cosa succede subito dopo la scelta"
                      },
                      "dopo": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mai": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
                            },
                            "minItems": 1
                          },
                          "gia": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
                            },
                            "minItems": 1
                          }
                        }
                      }
                    }
                  }
                },
                "commento": {
                  "$ref": "comune.schema.json#/$defs/testo",
                  "description": "commento del vice alla chiamata"
                },
                "senza": {
                  "type": "object",
                  "required": [
                    "settore"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "settore": {
                      "$ref": "comune.schema.json#/$defs/id"
                    },
                    "risorse": {
                      "type": "array",
                      "items": {
                        "$ref": "comune.schema.json#/$defs/id"
                      },
                      "minItems": 1
                    }
                  }
                },
                "dopo": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mai": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
                      },
                      "minItems": 1
                    },
                    "gia": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
                      },
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "esiti": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "se",
          "effetti",
          "verbale"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "comune.schema.json#/$defs/id"
          },
          "se": {
            "$ref": "comune.schema.json#/$defs/condizione"
          },
          "effetti": {
            "type": "array",
            "items": {
              "$ref": "comune.schema.json#/$defs/effetto"
            }
          },
          "verbale": {
            "$ref": "comune.schema.json#/$defs/testo"
          },
          "fallita": {
            "type": "boolean",
            "description": "esito di fallimento: l'episodio va rigiocato (D-059)"
          },
          "stelle_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "stelle minime con questo esito (D-064)"
          },
          "stelle_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "stelle massime con questo esito (D-064)"
          }
        }
      }
    },
    "fili": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "comune.schema.json#/$defs/id"
      }
    },
    "introduzione": {
      "type": "array",
      "items": {
        "$ref": "comune.schema.json#/$defs/testo"
      },
      "description": "battute del vice in sala operativa (D-054)"
    },
    "stelle": {
      "type": "object",
      "required": [
        "due",
        "tre"
      ],
      "additionalProperties": false,
      "description": "condizioni per 2 e 3 stelle su un episodio superato (1 stella = superato, 0 = fallito) (D-060)",
      "properties": {
        "due": {
          "$ref": "comune.schema.json#/$defs/condizione"
        },
        "tre": {
          "$ref": "comune.schema.json#/$defs/condizione"
        }
      }
    },
    "luogo": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "posizione dell'episodio sulla mappa della città, 0-100 (D-061)",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "bozza": {
      "type": "boolean",
      "description": "abbozzo giocabile da rifinire col PO (D-087): meccaniche esistenti, novità prevista annotata in docs/BOZZE_EPISODI.md"
    }
  }
}
