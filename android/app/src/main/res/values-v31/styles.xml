<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- C22-07: da Android 12 (API 31) il sistema non mostra l'immagine splash.png ma la schermata d'avvio fatta di
         un colore e dell'icona (https://developer.android.com/develop/ui/views/launch/splash-screen). Senza questi
         attributi usava il colore di sistema; qui il giallo e la V di Varcalda (primo piano dell'icona adattiva, già
         nel cerchio sicuro: 72 dp su 108, come chiedono i 192 dp su 288 dell'icona senza sfondo). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
